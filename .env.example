# Токены от @BotFather
USER_BOT_TOKEN=123456:ABC...
ADMIN_BOT_TOKEN=789012:DEF...

# ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# Текст или ссылка для QR оплаты
PAYMENT_QR_PAYLOAD=https://example.com/pay

# Юзернейм поддержки без @ (для раздела «Тех. поддержка», если нет SUPPORT_BOT_USERNAME)
SUPPORT_USERNAME=your_support

# Экран приветствия / после «Отмена» (как в вашем примере)
WELCOME_BRAND=NNN
SUPPORT_BOT_USERNAME=NNN
PUBLIC_CHAT_USERNAME=NNN
# Проценты в приветствии: можно 15, 15%, 12.5 (подставится «12.5%»)
WELCOME_DEPOSIT_PCT=0
WELCOME_WITHDRAW_PCT=0
# Одна строка; можно не задавать — будет текст про финконтроль по умолчанию
# WELCOME_SECURITY_LINE=🔒 Финансовый контроль обеспечен личным отделом безопасности

# Redis для FSM (опционально). Пусто — MemoryStorage (одна нода). Для масштаба — redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Картинка над приветствием (/start, отмена, /menu). Не задавать — подставится ссылка по умолчанию.
# Чтобы отключить: BRAND_LOGO_URL=
# BRAND_LOGO_URL=https://magicclick.partners/assets/images/1680278989.jpg

